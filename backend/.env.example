# ─── Reviveo backend configuration ──────────────────────────────────────────
# Copy to `.env` and fill in as needed. The app runs fully in synthetic mode
# with NONE of these set. Provide keys + set RUN_MODE=live to use real services.

# synthetic | live
RUN_MODE=synthetic

# Minimum-viable auth (A4). Sent by the frontend as the X-API-Key header.
API_KEY=reviveo-dev-key

# SQLite path (Postgres-swappable — only this connection string changes).
DATABASE_URL=reviveo.db

# Default (single) merchant for the hackathon; data model stays multi-merchant.
DEFAULT_MERCHANT_ID=codecraft

# ─── Razorpay (test mode) — only required when RUN_MODE=live ─────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Anthropic Claude — only required when RUN_MODE=live and use_ai=true ─────
# Swappable to Bedrock/Vertex by changing only the client init in ai_service.py.
# Fast/cheap model for per-event reasoning + messaging; larger model reserved
# only for approval summaries (low volume) — see doc C2.
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SUMMARY=claude-sonnet-5

# CORS origin for the Next.js dashboard
FRONTEND_ORIGIN=http://localhost:3000
